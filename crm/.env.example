# OccasionsBox CRM — environment variables
#
# Copy to .env.local for local development. On Vercel (project "ob-crm",
# Root Directory "crm") paste these in Settings → Environment Variables.
# The build succeeds with none of them set; at runtime the app serves a
# "not configured yet" page until the two NEXT_PUBLIC_SUPABASE_* values exist.

# --- Supabase (required at runtime) -----------------------------------------
# Project URL and anon (public) key: Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-only, bypasses RLS). Used by the ingest API,
# team invites, imports and other server routes. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest API ---------------------------------------------------------------
# Shared secret for server-to-server callers of /admin/api/v1/ingest/* (for
# example the ElevenLabs voice agent). Sent as the `x-api-key` header.
# Browser callers from the marketing site are authorised by Origin instead.
# Generate one with:  openssl rand -hex 32
SITE_API_KEY=

# Optional: comma-separated hostnames allowed to call the ingest API from a
# browser (Origin / Referer check). Defaults to occasionsbox.com,
# www.occasionsbox.com, ob-cinematic.vercel.app,
# ob-cinematic-vio-x-bergsify.vercel.app, ob-crm-vio-x-bergsify.vercel.app and
# localhost, plus any ob-cinematic-*.vercel.app preview host.
# ALLOWED_ORIGINS=occasionsbox.com,www.occasionsbox.com

# --- PayPal order verification (strongly recommended before launch) ----------
# When both are set, POST /admin/api/v1/ingest/order fetches the order from
# PayPal and only records it as paid ("Approved" stage) when PayPal reports
# status COMPLETED with a matching amount/currency; payer details are taken
# from PayPal. Without them, browser-reported orders are filed as
# "Unverified order: ..." in the first pipeline stage for manual confirmation.
# Dashboard: developer.paypal.com → Apps & Credentials (REST API app).
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_ENV=sandbox   # MUST match the account that issued the shop's client id.

# Stripe Checkout (card payments on the shop). The secret key creates the
# hosted Checkout Session; the signing secret belongs to the webhook endpoint
# you add in the Stripe dashboard pointing at
#   https://crm.occasionsbox.com/api/v1/webhooks/stripe
# for the event checkout.session.completed. Without STRIPE_WEBHOOK_SECRET no
# Stripe order is ever recorded, even though buyers are charged.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#                      # The shop uses client-id=BAAxKYq3MeBz… (a real id, not the
#                      # `sb` sandbox placeholder), so check developer.paypal.com
#                      # for which account owns it. Unset defaults to sandbox, and
#                      # a live order verified against sandbox is filed unverified.

# --- ElevenLabs voice agent (Olivia) ------------------------------------------
# Olivia's tools call /admin/api/v1/agent/* with SITE_API_KEY above as the
# x-api-key header. Her post-call webhook (every conversation, with summary
# and transcript) posts to /admin/api/v1/elevenlabs/post-call, signed with
# the secret ElevenLabs shows when the webhook is created
# (ElevenLabs dashboard → Settings → Webhooks → Post-call). Server-only.
# ELEVENLABS_WEBHOOK_SECRET=wsec_...

# --- Blotato social posting (optional) ---------------------------------------
# API key for Blotato, used server-side to publish to the connected social
# accounts. Server-only: never prefix with NEXT_PUBLIC_ and never read it from
# client code, or the key ships to the browser. Nothing calls Blotato yet, so
# this is read by no code today.
# BLOTATO_API_KEY=blt_...

# --- Public app URL (optional) ------------------------------------------------
# Absolute URL of the CRM including the /admin base path. Used to build the
# redirect for team-invite emails. When unset, the request origin is used.
# NEXT_PUBLIC_APP_URL=https://ob-crm-vio-x-bergsify.vercel.app/admin

# --- Email via Resend (optional) --------------------------------------------
# Enables sending from the Emails section. Without these, sends are disabled.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Collaborate@occasionsbox.com

# Who gets the email after every call or chat Olivia takes (comma separated).
# Falls back to the business email in crm.config. Needs the two Resend
# variables above to send at all.
# CALL_NOTIFY_EMAILS=Hello@occasionsbox.com

# Olivia's conversations. The post-call webhook needs a signing secret that
# only exists in the ElevenLabs dashboard, so the CRM also pulls her
# conversations from the ElevenLabs API on a schedule (see vercel.json) and
# files whatever the webhook did not deliver. The API key alone is enough to
# record every call and email the team; the agent id is optional and limits
# the sync to one agent.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# CRON_SECRET=          # optional bearer secret for triggering the sync by hand

# --- Set automatically ---------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH is injected by next.config.ts (value: /admin).
# Do not set it here.
